# Prisma Schema for CyberKavach Club

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  FACULTY_COORDINATOR
  STUDENT_COORDINATOR
  TECH_COORDINATOR
  CONTENT_COORDINATOR
  SOCIAL_MEDIA_COORDINATOR
  CLUB_MEMBER
  STUDENT_PARTICIPANT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  UNDER_REVIEW
}

enum RequestType {
  EVENT_PERMISSION
  RESOURCE_VENUE
  BUDGET_APPROVAL
  SOCIAL_MEDIA_POSTING
  CERTIFICATE_GENERATION
  EXTERNAL_COLLABORATION
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

// Models

model User {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  email               String   @unique
  name                String
  password            String
  role                UserRole
  department          String?
  phone               String?
  profileImage        String?
  isEmailVerified     Boolean  @default(false)
  isActive            Boolean  @default(true)
  lastLogin           DateTime?
  
  // Relations
  approvalRequests    ApprovalRequest[]
  approvedRequests    ApprovalRequest[] @relation("ApprovedBy")
  eventCreated        Event[]
  teamCreated         Team[]
  attendanceRecords   AttendanceRecord[]
  appreciationPoints  AppreciationPoints[]
  notifications       Notification[]
  certificates        Certificate[]
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model ApprovalRequest {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  requestType         RequestType
  status              ApprovalStatus @default(PENDING)
  title               String
  description         String
  requesterEmail      String
  requester           User     @relation(fields: [requesterId], references: [id])
  requesterId         String   @db.ObjectId
  
  approverEmail       String?
  approvedBy          User?    @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedById        String?  @db.ObjectId
  
  approvalNotes       String?
  timeline            String?
  priority            String   @default("NORMAL")
  escalationLevel     Int      @default(1)
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  approvedAt          DateTime?
}

model Event {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  description         String
  startDate           DateTime
  endDate             DateTime
  venue               String
  registrationDeadline DateTime
  status              EventStatus @default(DRAFT)
  
  organizerId         String   @db.ObjectId
  organizer           User     @relation(fields: [organizerId], references: [id])
  
  posterUrl           String?
  bannerUrl           String?
  registrationLink    String?
  
  capacity            Int      @default(0)
  registeredCount     Int      @default(0)
  
  // Relations
  teams               Team[]
  attendance          AttendanceRecord[]
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Team {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  eventId             String   @db.ObjectId
  event               Event    @relation(fields: [eventId], references: [id])
  
  leaderId            String   @db.ObjectId
  leader              User     @relation(fields: [leaderId], references: [id])
  
  members             String[] // Email list of members
  registrationStatus  ApprovalStatus @default(PENDING)
  memberCount         Int      @default(0)
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model AttendanceRecord {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId             String   @db.ObjectId
  event               Event    @relation(fields: [eventId], references: [id])
  
  participantEmail    String
  participant         User     @relation(fields: [participantId], references: [id])
  participantId       String   @db.ObjectId
  
  checkInTime         DateTime?
  checkOutTime        DateTime?
  checkInMethod       String   @default("MANUAL") // MANUAL, QR_CODE
  qrCodeScanned       String?
  
  status              String   @default("PENDING") // PENDING, CHECKED_IN, CHECKED_OUT
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Certificate {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  certificateId       String   @unique
  participantName     String
  participantEmail    String
  eventName           String
  eventId             String   @db.ObjectId
  
  issuedBy            User     @relation(fields: [issuedById], references: [id])
  issuedById          String   @db.ObjectId
  
  templateUrl         String
  pdfUrl              String?
  verificationUrl     String?
  
  isVerified          Boolean  @default(false)
  isTampered          Boolean  @default(false)
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model AppreciationPoints {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  memberId            String   @db.ObjectId
  member              User     @relation(fields: [memberId], references: [id])
  
  points              Int
  category            String   // Event Management, Creative Contribution, Technical, etc.
  reason              String
  awardedBy           String   // Email of person awarding
  
  totalPoints         Int      @default(0) // Cumulative points
  badges              String[] // Achievement badges
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Notification {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  recipientId         String   @db.ObjectId
  recipient           User     @relation(fields: [recipientId], references: [id])
  
  title               String
  message             String
  type                String   // APPROVAL_REQUEST, EVENT_REMINDER, ATTENDANCE, REWARD, etc.
  relatedId           String?  // Link to related resource
  
  isRead              Boolean  @default(false)
  readAt              DateTime?
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model AuditLog {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  userId              String
  action              String
  resource            String
  changes             String?  // JSON string of changes
  ipAddress           String?
  userAgent           String?
  
  createdAt           DateTime  @default(now())
}
